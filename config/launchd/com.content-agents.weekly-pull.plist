<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly analytics pull — runs `npm run pull:weekly` every Sunday at 07:00 local time so the DB
  is fresh before your Sunday /strategy. Nothing publishes; this only refreshes analytics.

  Install (see docs/setup-weekly-pull.md):
    mkdir -p ~/.content-agents/logs
    cp config/launchd/com.content-agents.weekly-pull.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.content-agents.weekly-pull.plist

  Change the day/time in StartCalendarInterval below, then unload + load again.
  bash -lc loads your profile so node/npm are on PATH under launchd's minimal environment.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.content-agents.weekly-pull</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/Muxin/Documents/GitHub/content-agents &amp;&amp; npm run pull:weekly</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/Muxin/.content-agents/logs/weekly-pull.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Muxin/.content-agents/logs/weekly-pull.log</string>
</dict>
</plist>
