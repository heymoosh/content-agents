<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly pattern mining. Runs `npm run patterns:weekly` every Monday at 08:00 local time: pulls
  fresh public posts from the accounts in config/pattern-mining.yaml on x, linkedin and substack,
  then runs a search-based discovery pass that PROPOSES new accounts. Nothing publishes, and no
  account is added to the config without an approve command Muxin runs herself.

  Committing this file installs nothing. Only the copy and load steps below do.

  Install (see docs/setup-patterns-weekly.md):
    mkdir -p ~/.content-agents/logs
    cp config/launchd/com.content-agents.patterns-weekly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.content-agents.patterns-weekly.plist

  Change the day/time in StartCalendarInterval below, then unload + load again.
  bash -lc loads your profile so node/npm are on PATH under launchd's minimal environment.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.content-agents.patterns-weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/Muxin/Documents/GitHub/content-agents &amp;&amp; npm run patterns:weekly</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/Muxin/.content-agents/logs/patterns-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Muxin/.content-agents/logs/patterns-weekly.log</string>
</dict>
</plist>
