<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bluesky mentions poll — runs `npm run bluesky-mentions` every 30 minutes so a new mention/reply
  is logged (data/bluesky-mentions-ledger.jsonl) soon after it lands. Detects + logs ONLY; drafts
  NOTHING and never publishes. Draft a reply for a logged mention by hand with:
    tsx src/atomize/reply-draft.ts --uri <at-uri>
  and review it like any other queued row (nothing ships until you set it to approve).

  Install (mirrors com.content-agents.notes-daily.plist):
    mkdir -p ~/.content-agents/logs
    cp config/launchd/com.content-agents.bluesky-mentions.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.content-agents.bluesky-mentions.plist

  Change the interval in StartInterval below (seconds), then unload + load again.
  bash -lc loads your profile so node/npm are on PATH under launchd's minimal environment.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.content-agents.bluesky-mentions</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/Muxin/Documents/GitHub/content-agents &amp;&amp; npm run bluesky-mentions</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/Muxin/.content-agents/logs/bluesky-mentions.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Muxin/.content-agents/logs/bluesky-mentions.log</string>
</dict>
</plist>
