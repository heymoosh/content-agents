node_modules/
.env
data/analytics.db*
data/research/
# raw quotes + respondent hashes never reach git -- same privacy treatment as data/analytics.db
venture/*/responses.jsonl
venture/*/evidence-links.jsonl
venture/*/cluster-analysis.json
data/notes-cache.json
data/inbox/**
!data/inbox/**/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/cost-log.csv
data/publish-schedule.jsonl
data/.test-publish-schedule.*.jsonl
# notes-spread-ledger.jsonl is intentionally committed (cloud dedup memory) — keep it tracked
!data/notes-spread-ledger.jsonl
content/.inbox/
content/**/video/*.mp4
content/**/video/*.wav
content/**/video/*.mp3
content/**/images/*.png
content/**/images/*.jpg
content/**/images/*.mp4
/bakeoff/
.remotion/
out/
*.log
docs/*.lock
.DS_Store
.conductor-preflight-stamp

# design-sync capture output (regenerate with npm run design:capture)
.design-sync/build/

# mined pattern corpus: other creators' full post text and video transcripts never reach git,
# same privacy treatment as data/analytics.db. Only the distilled patterns get committed.
data/patterns/**
!data/patterns/.gitkeep
!data/patterns/inbox/
!data/patterns/inbox/.gitkeep

# End-to-end suite outputs (the suite writes for real; only its .ts sources are tracked)
e2e/*.log
e2e/results.jsonl
e2e/RESULTS.md

# Rewrite proposals are working files, not content. Muxin takes what she wants by hand.
*.rewrite.md
